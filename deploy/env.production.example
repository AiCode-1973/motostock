# MotoStock · .env de PRODUÇÃO para https://motostock.aicode.dev.br
# Copie para deploy/.env.production (fica fora do Git) e preencha os campos marcados com <<< >>>.
# Na primeira instalação ele vira o .env do servidor. Nas atualizações o .env do servidor NUNCA é sobrescrito.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://motostock.aicode.dev.br
APP_BASE_PATH=
# <<< Gere com: php bin/generate-key.php  — guarde uma cópia no cofre de senhas. Nunca troque depois de instalar. >>>
APP_KEY=

# As lojas abrem em https://motostock.aicode.dev.br/loja/<endereco-da-loja>.
# Subdomínio por loja (loja.motostock.aicode.dev.br) exige DNS curinga e SSL curinga: ver docs/05.
APP_BASE_DOMAIN=motostock.aicode.dev.br
STORE_USE_SUBDOMAINS=false
STORE_PATH_FALLBACK=true
ALLOW_CUSTOM_DOMAINS=false
TRUST_PROXY=false

# <<< Banco criado no cPanel › Bancos de dados MySQL (prefixo da conta, ex.: conta_motostock) >>>
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_NAME=motostock_sid
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_MINUTES=720
PLATFORM_REQUIRE_MFA=true

# mail() do servidor (Exim do cPanel). O remetente deve ser de um domínio com SPF/DKIM na hospedagem.
MAIL_DRIVER=mail
MAIL_FROM=nao-responda@aicode.dev.br

# Pagamento online real: cada loja configura o Mercado Pago no painel.
# Deixe o simulado DESLIGADO em produção (ligue só se quiser uma demonstração pública, avisando que é simulação).
PAYMENT_GATEWAY=mercadopago
SIMULATED_GATEWAY_ENABLED=false
ORDER_PAYMENT_TTL_HOURS=48

TENANT_RETENTION_DAYS=90
PAST_DUE_GRACE_DAYS=7

# <<< Primeiro administrador da plataforma: criado automaticamente no envio. >>>
# A senha (12+ caracteres) é apagada deste arquivo e do .env do servidor assim que a conta é criada.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Opcional (plano B): instalação pelo navegador em /instalacao?token=... (32+ caracteres). Deixe vazio se não usar.
SETUP_TOKEN=
