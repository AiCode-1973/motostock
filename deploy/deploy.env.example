# MotoStock · credenciais de ENVIO por FTP (copie para deploy/.deploy.env — fora do Git)
FTP_HOST=ftp.aicode.dev.br
FTP_USER=
FTP_PASS=
# Pasta raiz do domínio motostock.aicode.dev.br no FTP (veja em cPanel › Domínios; ex.: /public_html ou /motostock.aicode.dev.br)
FTP_PATH=/public_html
APP_URL=https://motostock.aicode.dev.br
# Token só do extrator do pacote (qualquer texto aleatório, 24+ caracteres)
DEPLOY_TOKEN=
