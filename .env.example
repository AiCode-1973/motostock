# MotoStock · copie para .env e preencha. Nunca versionar o .env real.

APP_ENV=local
APP_DEBUG=true
# URL pública do painel (com subpasta, se houver). Ex.: https://app.motostock.com.br
APP_URL=http://localhost:8080
# Deixe vazio para detectar automaticamente; use /motostock se rodar em subpasta do Apache.
APP_BASE_PATH=
# Gere com: php bin/generate-key.php
APP_KEY=

# Domínio base das lojas: <slug>.APP_BASE_DOMAIN (ex.: motostock.com.br). Em dev: localhost
APP_BASE_DOMAIN=localhost
STORE_USE_SUBDOMAINS=false
# Em desenvolvimento a loja também abre em /loja/<slug>
STORE_PATH_FALLBACK=true
# Domínio próprio por loja (exige DNS + verificação; ver docs/05)
ALLOW_CUSTOM_DOMAINS=false
# true só atrás de proxy/CDN confiável que envie X-Forwarded-For/Proto
TRUST_PROXY=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=motostock
DB_USERNAME=motostock
DB_PASSWORD=

SESSION_NAME=motostock_sid
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_MINUTES=720
PLATFORM_REQUIRE_MFA=true

# log | mail | null  (SMTP autenticado: ver docs/06)
MAIL_DRIVER=log
MAIL_FROM=nao-responda@motostock.com.br

# Pagamentos: simulated (dev/homologação) | mercadopago
PAYMENT_GATEWAY=simulated
SIMULATED_GATEWAY_ENABLED=true
ORDER_PAYMENT_TTL_HOURS=48

# Ciclo de vida dos tenants
TENANT_RETENTION_DAYS=90
PAST_DUE_GRACE_DAYS=7
