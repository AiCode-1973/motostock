# Use somente se a hospedagem não permitir apontar o domínio para a pasta public/.
# Bloqueia tudo que não é público e encaminha o resto para public/.
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|bin|database|docs|storage|tests)(/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
